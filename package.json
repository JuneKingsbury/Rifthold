{
  "name": "rifthold",
  "version": "0.2.0",
  "description": "Rifthold: Arcane Frontiers",
  "main": "electron-main.js",
  "author": "June \"Mars\" Kingsbury",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --mac --win --linux",
    "copy:web": "rsync -a --delete --exclude='node_modules' --exclude='dist' --exclude='.git' --exclude='android' --exclude='www' --exclude='electron-main.js' --exclude='preload.js' --exclude='.claude' --exclude='BUILD_INSTRUCTIONS.txt' --exclude='Todo.md' --exclude='README.md' --exclude='package.json' --exclude='package-lock.json' --exclude='capacitor.config.ts' --exclude='.gitignore' --exclude='.DS_Store' . www/",
    "cap:sync": "npm run copy:web && npx cap sync android",
    "cap:android": "npm run cap:sync && npx cap open android",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.rifthold.game",
    "productName": "Rifthold",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!.claude/**",
      "!.DS_Store",
      "!Todo.md",
      "!README.md",
      "!steam_appid.txt"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
